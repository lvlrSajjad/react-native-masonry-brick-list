{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // index.d.ts lives one level up, where `react` and `react-native` would
    // otherwise resolve to the library's untyped test deps (or not at all).
    "paths": {
      "react-native-masonry-brick-list": ["../index.d.ts"],
      "react": ["./node_modules/@types/react"],
      "react-native": ["./node_modules/react-native"]
    }
  }
}
